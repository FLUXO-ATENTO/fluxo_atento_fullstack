NUXT_PUBLIC_SITE_URL=https://fluxoatento.com.br
NUXT_PUBLIC_DASHBOARD_URL=https://app.fluxoatento.com.br
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility with the public variable already configured in Netlify.
NUXT_PUBLIC_SUPABASE_KEY=
# Enable only after provider credentials and redirects are configured and tested.
# Supported values: google,github. This is not an API key.
NUXT_PUBLIC_AUTH_PROVIDERS=
NUXT_PUBLIC_API_BASE=https://api.fluxoatento.com.br

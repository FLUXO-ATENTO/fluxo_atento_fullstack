# Copy to /etc/fluxo-atento/dashboard-build.env on the VPS.
# This file is sourced only during the static build. Keep it root-owned (0600).
# Values prefixed NUXT_PUBLIC_ are intentionally visible to the browser.

NUXT_PUBLIC_SITE_URL=https://app.fluxoatento.com.br
NUXT_PUBLIC_DASHBOARD_URL=https://app.fluxoatento.com.br
NUXT_PUBLIC_MARKETING_URL=https://fluxoatento.com.br
NUXT_PUBLIC_API_BASE=https://api.fluxoatento.com.br
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring and validating the matching Supabase provider.
# Example: google (or google,github when both are ready). This is not a secret.
# Requires a reviewed rebuild/deploy; changing this flag does not configure OAuth.
NUXT_PUBLIC_AUTH_PROVIDERS=

# Never put service_role, sb_secret_, database passwords, JWT signing secrets
# or SSH credentials in this file.

    "motion-v": "2.6.0",
    "nuxt": "^4.6.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "1.2.142",

# This file contains names only. Store real values outside the checkout on the VPS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://app.fluxoatento.com.br/auth/callback
ALLOWED_ORIGINS=https://app.fluxoatento.com.br
HOST=127.0.0.1
PORT=8100

# Optional, private VPS only. The database switch starts disabled.
# Separate OAuth client from Supabase login; Analytics/SC read-only scopes only.
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
# Canonical base64 of exactly 32 cryptographically random bytes. Never public.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_REDIRECT_URL=https://api.fluxoatento.com.br/v1/integrations/google/callback
